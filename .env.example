# Public canonical URL used by SEO metadata, sitemap, and structured data.
VITE_SITE_URL=https://your-domain.example

# Optional public contact form endpoint (Formspree, Web3Forms, Netlify-compatible, etc.).
# Leave empty to use the mailto fallback. Do not put private API keys in client-side variables.
VITE_CONTACT_FORM_ENDPOINT=
# Backwards-compatible alias used by older configuration examples.
VITE_CONTACT_ENDPOINT=

# Optional showcase toolbar. Development mode also shows the toolbar.
VITE_SHOWCASE_MODE=false

# For GitHub Pages project sites, set this to /your-repository-name/ before building.
VITE_BASE_PATH=/
